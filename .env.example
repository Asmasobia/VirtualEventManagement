# ─────────────────────────────────────────────────────────────────────────────
#  Copy to `.env` and fill in real values. `.env` is gitignored; this file is
#  committed, and it exists so that a new contributor (or you, on a new machine)
#  learns which variables the app needs WITHOUT reading every require() call.
#
#  Nothing in this file may be a real credential. Placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3000

# ─── Database (MongoDB) ──────────────────────────────────────────────────────
# Required; the app refuses to start without a valid-looking value. Must include a
# database name after the host — otherwise the driver silently uses "test".
# A hosted cluster's string contains a password: put the real one in `.env` only,
# never here.
MONGODB_URI=mongodb://127.0.0.1:27017/virtual_events

# Optional. Read ONLY by the test suite (NODE_ENV=test), which never reads
# MONGODB_URI — the suite drops its database, so it must not be able to reach the
# one above. Defaults to a local `virtual_events_test`; the name must end in
# `_test` or the suite refuses to run. Set it for CI or a non-default host.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/virtual_events_test

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Long and random matters more than clever: this single value is the only thing
# standing between a forged token and full account takeover, because the payload
# is signed, not encrypted — anyone can read it, only the holder of this secret
# can mint one.
JWT_SECRET=replace-me-with-48-random-bytes

# ⚠️ MUST be set. `jwt.sign(..., { expiresIn: undefined })` does not throw and
#    does not default — it mints a token with NO expiry, valid forever. An empty
#    or missing value here silently turns every login into a permanent
#    credential, which is why the app should fail fast on startup instead of
#    trusting this file to be complete.
JWT_EXPIRES_IN=1h

# ─── Email (nodemailer) ──────────────────────────────────────────────────────
# ⚠️ These two groups are mutually exclusive. They used to be the source of a
#    silent bug: the code read EMAIL_SERVICE, which was never defined, while
#    EMAIL_HOST / EMAIL_PORT were defined and never read — so every send failed
#    and the failure was swallowed. Symptom: "it works, emails just never
#    arrive." `config/env.js` now reads both groups; if neither is usable,
#    email is disabled and the app says so once at startup, rather than
#    failing every send quietly. (Deliberately not fatal — a courtesy email
#    must not be a hard dependency of booting.)
#
# Pick ONE:
#   (a) a well-known provider shortcut, which implies host+port+secure:
EMAIL_SERVICE=gmail
#   (b) or an explicit SMTP endpoint, which is what you want for a local
#       mail-catcher such as MailHog or Mailpit:
# EMAIL_HOST=localhost
# EMAIL_PORT=1025

EMAIL_USER=you@example.com
# For Gmail this is an App Password, not your account password.
EMAIL_PASS=replace-me
EMAIL_FROM=Virtual Event Platform <you@example.com>
