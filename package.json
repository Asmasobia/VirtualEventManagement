{
  "name": "virtualeventmanagement",
  "version": "1.0.0",
  "description": "REST API for hosting and attending virtual events: JWT auth, role-based access, event lifecycle, and attendee registration.",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Asma Sobia",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.7.0",
    "nodemailer": "10.0.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "jest": "30.2.0",
    "nodemon": "3.1.11",
    "prettier": "3.9.6",
    "supertest": "7.2.2"
  }
}
